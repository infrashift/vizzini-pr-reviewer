# /etc/vizzini-webhook/vizzini-webhook.env (EXPERIMENTAL; mode 0644).
# Non-secret settings. Secrets go in secrets.env (0600) and webhook.secret
# (0600). Runbook: deploy/webhook/README.md.

# The receiver listens on loopback; the TLS reverse proxy forwards to it.
WEBHOOK_LISTEN=127.0.0.1:8484
# The one repository this receiver answers for: dev.azure.com/ORG/PROJECT/REPO.
WEBHOOK_REPO=dev.azure.com/ORG/PROJECT/REPO
WEBHOOK_MAX_JOBS=2
WEBHOOK_MAX_COMMANDS=5

# vizzini-bot's model gateway.
VIZZINI_LITELLM_URL=https://litellm.example.com/v1
VIZZINI_MODEL=claude-sonnet-5-5

# The tools vizzini-bot runs (installed by deploy/ci/install.sh).
VIZZINI_MRMAN=/opt/vizzini/bin/mrman
VIZZINI_GARMR=/opt/vizzini/bin/garmr
TIKTOKEN_CACHE_DIR=/opt/vizzini/tiktoken
PATH=/opt/vizzini/bin:/usr/local/bin:/usr/bin:/bin
