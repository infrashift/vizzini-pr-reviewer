# /etc/vizzini-webhook/secrets.env (EXPERIMENTAL; mode 0600, owner root).
# Write the real values with an editor on the host. Never commit this file.

# PAT of the dedicated bot account, scope Code (Read & Write). The receiver
# fetches the pull request with it, and vizzini-bot replies with it, as that
# account.
AZURE_DEVOPS_EXT_PAT=
# The LiteLLM virtual key for the bot (give it a budget).
VIZZINI_API_KEY=
