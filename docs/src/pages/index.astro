---
// Landing page: not managed by Starlight.
import { Image } from 'astro:assets';
import '../styles/landing.css';
import mascot from '../assets/vizzini.jpeg';

// Produced by Vizzini's own code (the diff renderer and the CUE validator).
// Regenerate with `go run ./docs/src/demo/gen.go` from the repository root.
import reviewInput from '../demo/review-input.txt?raw';
import reviewOutput from '../demo/review-output.json?raw';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/infrashift/vizzini-pr-reviewer';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Color the annotated diff by line kind: file header, hunk header, + / - / context.
const diffHtml = reviewInput
	.trimEnd()
	.split('\n')
	.map((line) => {
		let cls = 'ctx';
		if (line.startsWith('### ')) cls = 'hdr';
		else if (line.startsWith('@@')) cls = 'hunk';
		else {
			const op = /^[\d ]+?([+-]) /.exec(line);
			if (op) cls = op[1] === '+' ? 'add' : 'del';
		}
		return `<span class="${cls}">${esc(line)}</span>`;
	})
	.join('\n');

// Light JSON highlighting: keys, strings, numbers; severity values stand out.
const jsonHtml = esc(reviewOutput.trimEnd()).replace(
	/("(?:[^"\\]|\\.)*")(\s*:)?|\b(\d+)\b/g,
	(m: string, str?: string, colon?: string, num?: string) => {
		if (num) return `<span class="num">${num}</span>`;
		if (colon) return `<span class="key">${str}</span>${colon}`;
		if (str && /^"(Critical|Major|Minor|Trivial)"$/.test(str)) return `<span class="sev">${str}</span>`;
		return `<span class="str">${str}</span>`;
	},
);
---

<html lang="en" data-theme="dark">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Vizzini: AI Code Review That Checks the Model's Work</title>
	<meta name="description" content="Vizzini is a pure-Go AI code review engine. It chunks diffs by tokens, asks any model behind a LiteLLM proxy for findings, and rejects every answer that fails its CUE schema. Built to embed in mrman and run in UBI9 containers or offline microVMs." />
	<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body>

<nav class="nav">
	<a href={base} class="nav-logo"><span class="prompt">&gt;</span> vizzini</a>
	<ul class="nav-links">
		<li><a href={`${base}docs/`}>Docs</a></li>
		<li><a href={`${base}docs/getting-started/`}>Quick Start</a></li>
		<li class="hide-sm"><a href={`${base}docs/reference/review-schema/`}>Schema</a></li>
		<li class="hide-sm"><a href={`${base}docs/project/roadmap/`}>Roadmap</a></li>
		<li><a href={repo}>GitHub</a></li>
		<li><button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">&#9790;</button></li>
	</ul>
</nav>

<section class="hero">
	<Image
		src={mascot}
		alt="The Go gopher as a curly-haired Renaissance schemer in an embroidered doublet, arms spread in triumph over two silver goblets of wine, a wheel of cheese and a dagger, on a rocky clifftop above the sea."
		class="mascot"
		width={1600}
		widths={[480, 800, 1200, 1600]}
		sizes="(max-width: 46rem) calc(100vw - 2rem), 44rem"
		format="webp"
		quality={80}
		loading="eager"
		fetchpriority="high"
	/>
	<div class="wordmark"><span class="prompt">&gt;</span> vizzini<span class="caret">_</span></div>
	<h1>AI code review that never takes the model's word for it</h1>
	<p class="tagline">
		Vizzini packs your diff into token-sized chunks, asks any model behind a <strong>LiteLLM</strong> proxy for findings,
		and checks every answer against a <strong>CUE schema</strong> before it reaches you.
		If an answer fails, the error goes back to the model to fix.
		Written in pure Go as a static binary, ready to embed in <strong>mrman</strong> or run offline in a microVM.
	</p>
	<div class="hero-cta">
		<a href={`${base}docs/getting-started/`} class="btn btn-primary">Get Started</a>
		<a href={`${base}docs/guides/how-it-works/`} class="btn btn-secondary">How It Works</a>
		<a href={repo} class="btn btn-ghost">GitHub &rarr;</a>
	</div>
</section>

<section class="install">
	<code>git clone {repo} &amp;&amp; cd vizzini-pr-reviewer &amp;&amp; make build</code>
	<span class="note">
		Needs Go 1.25+. Not released yet: the <code>pr-review</code> CLI and <code>pkg/reviewer</code> API work today, and a first tag is coming soon. <a href={`${base}docs/getting-started/`}>Try it from source.</a>
	</span>
</section>

<section class="demo">
	<div class="demo-grid">
		<div class="terminal">
			<div class="terminal-bar">
				<span class="dot"></span><span class="dot"></span><span class="dot"></span>
				<span class="title">what the model sees &nbsp;·&nbsp; annotated diff</span>
			</div>
			<pre set:html={diffHtml}></pre>
		</div>
		<div class="terminal">
			<div class="terminal-bar">
				<span class="dot"></span><span class="dot"></span><span class="dot"></span>
				<span class="title">what you get &nbsp;·&nbsp; validated finding</span>
			</div>
			<pre class="wrap" set:html={jsonHtml}></pre>
		</div>
	</div>
	<p class="demo-caption">
		Left: the diff exactly as Vizzini renders it for the prompt, with old and new line numbers so findings point at real lines.
		Right: a review that passes <code>schema/review.cue</code>. Both are generated by Vizzini's own code.
	</p>
</section>

<section class="features">
	<h2>Why Vizzini?</h2>
	<div class="feature-grid">
		<div class="feature-card">
			<div class="icon">&#9878;</div>
			<h3>Every Answer Checked</h3>
			<p>Responses are unified with closed CUE definitions. A <code>"High"</code> where the schema says <code>"Major"</code>, an <code>end_line</code> before its <code>start_line</code>, or an invented field is rejected, and the error goes back to the model to fix.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#9986;</div>
			<h3>Token-Aware Chunking</h3>
			<p>Diffs are packed into chunks within a tiktoken budget. Large files split only between hunks, never in the middle of one, and the token counts are exact, not estimated.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#128205;</div>
			<h3>Line-Anchored Findings</h3>
			<p>Every line in a hunk is labeled with its old and new line number, so the model points at lines that exist instead of guessing at offsets.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#128268;</div>
			<h3>Any Model, One Proxy</h3>
			<p>Speaks the OpenAI chat API to your internal LiteLLM proxy in JSON mode. Retries transient failures with backoff, and never retries a client error.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#128230;</div>
			<h3>Pure Go, Static Binary</h3>
			<p><code>CGO_ENABLED=0</code> everywhere. Drop it into a minimal UBI9 image or a QEMU microVM with no libc dependency.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#128274;</div>
			<h3>Offline by Design</h3>
			<p>Tokenizer encodings are pinned by checksum and pre-seeded, so token counting never needs the network. The test suite blocks network access to prove it.</p>
		</div>
	</div>
</section>

<section class="roadmap">
	<h2>Where it's headed</h2>
	<p class="subtitle">Each milestone is tracked as an issue and lands as its own tested commit.</p>
	<div class="roadmap-grid">
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>Engine core</strong><span>Diff parsing, chunking, CUE schema, LiteLLM client</span><br /><span class="status done">Done</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>CLI &amp; Go API</strong><span>describe · review · improve</span><br /><span class="status done">Done</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>Policy gate</strong><span>Exit 2 on Critical/Major</span><br /><span class="status done">Done</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>Lint + AI</strong><span>golangci-lint findings in the prompt</span><br /><span class="status done">Done</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>Risk scoring</strong><span>Blast radius &amp; auto-approve</span><br /><span class="status">Planned</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>OKF grounding</strong><span>Cite your design decisions</span><br /><span class="status">Planned</span>
		</a>
	</div>
</section>

<section class="callout">
	<div class="callout-inner">
		<h3>Never go up against a CUE schema when JSON is on the line</h3>
		<p>The model can be as clever as it likes. Vizzini only accepts answers that unify with the schema, and anything else goes back to the model to fix before you ever see it.</p>
		<a href={`${base}docs/reference/review-schema/`} class="btn btn-primary">Review Schema</a>
		<a href={`${base}docs/guides/how-it-works/`} class="btn btn-secondary">How It Works</a>
	</div>
</section>

<footer class="landing-footer">
	<p>Built by <a href="https://github.com/infrashift">InfraShift</a> &middot; Companion to <a href="https://infrashift.github.io/mrman/">mrman</a></p>
</footer>

<script>
const toggle = document.getElementById('theme-toggle');
const html = document.documentElement;

function setTheme(theme: string) {
	html.setAttribute('data-theme', theme);
	localStorage.setItem('vizzini-theme', theme);
	if (toggle) toggle.textContent = theme === 'dark' ? '☾' : '☀';
}

toggle?.addEventListener('click', () => {
	setTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
});

setTheme(localStorage.getItem('vizzini-theme') || 'dark');
</script>

</body>
</html>
